PORT=5000
CLIENT_ORIGINS=http://localhost:5173,http://localhost:8081

# Local dev: point at a local Postgres instance.
# Staging/production: set these to your Neon (or other hosted Postgres)
# connection details in the host's own environment config -- never commit
# real credentials here.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=vartakaro
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

OTP_EXPIRES_IN_MINUTES=5

# Create an OAuth 2.0 Client ID (type "Web application") in Google Cloud
# Console and put its client ID here. This is the same value the client
# uses as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
