# Leave empty for local dev (Vite proxies /api and /socket.io to localhost:5000).
# Set to your deployed backend origin when the client is hosted separately, e.g.:
# VITE_API_URL=https://varta-karo.onrender.com
VITE_API_URL=

# Free Cloudinary account (cloudinary.com) -- uploads go straight from the
# browser to Cloudinary, not through the backend. Cloud name is on your
# dashboard; the preset is one you create under Settings > Upload with
# Signing Mode set to "Unsigned". Neither value is secret.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
